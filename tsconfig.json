{
  "compilerOptions": {
    "target": "ES2022",
    // node16 + a package.json without "type": "module" == CommonJS output, and
    // it is the only resolution mode TS 7 offers that honors "exports" maps
    // (the MCP SDK's ./server/*.js subpaths need it).
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
